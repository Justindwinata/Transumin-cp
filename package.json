{
  "name": "transum-in-nexus",
  "version": "0.0.0",
  "private": true,
  "description": "Executable monorepo foundation for TRANSUM-IN NEXUS.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "22.23.2",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "node scripts/dev/with-env.mjs --parallel --filter @transum-in/web --filter @transum-in/api dev",
    "dev:web": "node scripts/dev/with-env.mjs --filter @transum-in/web dev",
    "dev:api": "node scripts/dev/with-env.mjs --filter @transum-in/api dev",
    "db:up": "docker compose up -d --build --wait postgres",
    "db:down": "docker compose down --remove-orphans",
    "db:migrate": "pnpm --filter @transum-in/api db:migrate",
    "db:status": "pnpm --filter @transum-in/api db:status",
    "test:demo": "pnpm --filter @transum-in/api test:demo",
    "demo:present": "pnpm --filter @transum-in/api demo:present",
    "db:reset": "docker compose down --volumes --remove-orphans && docker compose up -d --build --wait postgres && pnpm db:migrate",
    "data:transjakarta:fetch": "pnpm --filter @transum-in/api data:transjakarta:fetch",
    "data:transjakarta:validate": "pnpm --filter @transum-in/api data:transjakarta:validate",
    "data:transjakarta:ingest": "pnpm --filter @transum-in/api data:transjakarta:ingest",
    "data:transjakarta:verify": "pnpm --filter @transum-in/api data:transjakarta:verify",
    "data:spatial:fetch": "pnpm --filter @transum-in/api data:spatial:fetch",
    "data:spatial:validate": "pnpm --filter @transum-in/api data:spatial:validate",
    "data:spatial:ingest": "pnpm --filter @transum-in/api data:spatial:ingest",
    "data:spatial:verify": "pnpm --filter @transum-in/api data:spatial:verify",
    "data:twin:snapshot": "pnpm --filter @transum-in/api data:twin:snapshot",
    "data:twin:verify": "pnpm --filter @transum-in/api data:twin:verify",
    "data:petabencana:probe": "pnpm --filter @transum-in/api data:petabencana:probe",
    "data:petabencana:ingest": "pnpm --filter @transum-in/api data:petabencana:ingest",
    "data:phase3:verify": "pnpm --filter @transum-in/api data:phase3:verify",
    "data:phase3:benchmark": "pnpm --filter @transum-in/api data:phase3:benchmark",
    "data:phase4ar:verify": "pnpm --filter @transum-in/api data:phase4ar:verify",
    "data:phase4ba:prepare": "pnpm --filter @transum-in/api data:phase4ba:prepare",
    "data:phase4ba:validate": "pnpm --filter @transum-in/api data:phase4ba:validate",
    "data:phase4bb:verify": "pnpm --filter @transum-in/api data:phase4bb:verify",
    "data:phase4bb:record": "pnpm --filter @transum-in/api data:phase4bb:record",
    "data:phase4bb:identity": "pnpm --filter @transum-in/api data:phase4bb:identity",
    "data:phase5a:verify": "pnpm --filter @transum-in/api data:phase5a:verify",
    "data:phase5a:record": "pnpm --filter @transum-in/api data:phase5a:record",
    "data:phase5b:verify": "pnpm --filter @transum-in/api data:phase5b:verify",
    "data:product-p1:verify": "pnpm --filter @transum-in/api data:product-p1:verify",
    "data:product-p1r:serve": "pnpm --filter @transum-in/api data:product-p1r:serve",
    "data:cp2:isolated-browser": "pnpm --filter @transum-in/api data:cp2:isolated-browser",
    "data:browser:isolated": "pnpm --filter @transum-in/api data:browser:isolated",
    "data:cp3:recovery": "pnpm --filter @transum-in/api data:cp3:recovery",
    "data:phase5b:record": "pnpm --filter @transum-in/api data:phase5b:record && prettier --write data/manifests/RUN-5B-RECOVERY-COMPARISON-EVIDENCE.json",
    "otp:preflight": "bash scripts/routing/otp-phase4ba.sh preflight",
    "otp:prepare": "bash scripts/routing/otp-phase4ba.sh prepare",
    "otp:build": "bash scripts/routing/otp-phase4ba.sh build",
    "otp:start": "bash scripts/routing/otp-phase4ba.sh start",
    "otp:health": "bash scripts/routing/otp-phase4ba.sh health",
    "otp:stop": "bash scripts/routing/otp-phase4ba.sh stop",
    "otp:restart": "bash scripts/routing/otp-phase4ba.sh restart",
    "otp:routeability": "bash scripts/routing/otp-phase4ba.sh routeability",
    "data:contracts:check": "node scripts/data/validate-data-contracts.mjs",
    "data:phase1:verify": "node scripts/data/validate-data-contracts.mjs --phase1",
    "build": "pnpm -r --if-present build",
    "lint": "eslint apps/web/src apps/api/src packages/shared-types/src",
    "typecheck": "pnpm --filter @transum-in/shared-types build && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check:integration": "pnpm --filter @transum-in/api test:integration",
    "acceptance:v1:multi-od": "node scripts/acceptance/v1-multi-od.mjs",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,json}\" \"scripts/**/*.mjs\" \".github/workflows/*.yml\" docker-compose.yml package.json pnpm-workspace.yaml tsconfig.base.json eslint.config.mjs prettier.config.mjs README.md apps/api/README.md \"data/**/*.{md,json}\" \"database/**/*.md\" docs/api/README.md \"docs/architecture/LIVE-OPERATIONAL-DATA-ARCHITECTURE.md\" \"docs/architecture/PHASE-2A-SPATIAL-FOUNDATION.md\" \"docs/architecture/HYBRID-MOBILITY-TWIN-ARCHITECTURE.md\" \"docs/architecture/MULTIMODAL-ROUTING-ARCHITECTURE.md\" \"docs/adr/ADR-005-DEVELOPMENT-TOOLCHAIN.md\" \"docs/adr/ADR-006-DATABASE-INFRASTRUCTURE.md\" \"docs/adr/ADR-007-LOGICAL-TRANSIT-SEGMENTS.md\" \"docs/adr/ADR-008-SPATIAL-IDENTITY-AND-PEDESTRIAN-INTERCHANGE.md\" \"docs/adr/ADR-009-HYBRID-MOBILITY-TWIN-AND-RAIL-TOPOLOGY-SEMANTICS.md\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,json}\" \"scripts/**/*.mjs\" \".github/workflows/*.yml\" docker-compose.yml package.json pnpm-workspace.yaml tsconfig.base.json eslint.config.mjs prettier.config.mjs README.md apps/api/README.md \"data/**/*.{md,json}\" \"database/**/*.md\" docs/api/README.md \"docs/architecture/LIVE-OPERATIONAL-DATA-ARCHITECTURE.md\" \"docs/architecture/PHASE-2A-SPATIAL-FOUNDATION.md\" \"docs/architecture/HYBRID-MOBILITY-TWIN-ARCHITECTURE.md\" \"docs/architecture/MULTIMODAL-ROUTING-ARCHITECTURE.md\" \"docs/adr/ADR-005-DEVELOPMENT-TOOLCHAIN.md\" \"docs/adr/ADR-006-DATABASE-INFRASTRUCTURE.md\" \"docs/adr/ADR-007-LOGICAL-TRANSIT-SEGMENTS.md\" \"docs/adr/ADR-008-SPATIAL-IDENTITY-AND-PEDESTRIAN-INTERCHANGE.md\" \"docs/adr/ADR-009-HYBRID-MOBILITY-TWIN-AND-RAIL-TOPOLOGY-SEMANTICS.md\"",
    "openapi:validate": "redocly lint docs/api/openapi-v1.yaml --extends spec",
    "security:scan": "node scripts/acceptance/security-secret-scan.mjs",
    "api:types": "node scripts/dev/generate-openapi-types.mjs",
    "api:types:check": "node scripts/dev/generate-openapi-types.mjs --check",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm data:contracts:check && pnpm openapi:validate && pnpm api:types:check && pnpm format:check && pnpm build",
    "data:contracts:metadata": "node scripts/data/validate-data-contracts.mjs --metadata-only",
    "check:source": "pnpm lint && pnpm typecheck && pnpm test && pnpm data:contracts:metadata && pnpm openapi:validate && pnpm api:types:check && pnpm format:check && pnpm build",
    "passenger:local": "node scripts/dev/with-env.mjs --filter @transum-in/api exec tsx src/journey/cp2-isolated-browser.cli.ts --suite=SMOKE --production-web --exact-runtime-grants --serve-local"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.8",
    "@redocly/cli": "2.54.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
