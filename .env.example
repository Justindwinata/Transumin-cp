# Safe local-development defaults and future provider placeholders.
# Never commit real credentials or secrets.

APP_ENV=development
WEB_PORT=3000
API_PORT=3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
PASSENGER_API_BASE_URL=http://localhost:3001/api/v1
# Same-origin operator proxy; upstream is private and must include /api/v1.
OPS_API_BASE_URL=http://127.0.0.1:3001/api/v1
# Exact browser origins for authenticated cookie mutations. Set your HTTPS origin
# for staging; empty values fail closed. Optional localhost development opt-in.
AUTH_ORIGIN=
PUBLIC_ORIGIN=
AUTH_ALLOW_LOOPBACK_ORIGIN=false
PASSENGER_NETWORK_SNAPSHOT_ID=43fb9a29-0c89-5c72-8826-e3dc2adcfb1f
# Required for server-minted prototype passenger sessions; use 32+ random characters locally.
PASSENGER_SESSION_SECRET=
# Internal proxy → API identity; direct protected routes reject missing/invalid token.
PASSENGER_SERVICE_TOKEN=
# Development/test-only controlled report review; never official operational evidence.
CONTROLLED_REVIEW_TOKEN=
CONTROLLED_REVIEW_ENABLED=false

# Containerized PostgreSQL + PostGIS. Set local values in an ignored .env file.
# POSTGRES_PORT defaults to 5433 when omitted.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Optional connection-string override for the discrete fields above.
DATABASE_URL=

# Future routing adapter endpoint
ROUTING_PROVIDER_URL=

# Future provider identifier only; provider credentials are intentionally absent
LLM_PROVIDER=

# ADR-010: optional server-only upstream for the separate admin review service.
# Leave empty until a loopback service with a separate restricted DB role exists.
# Passenger API must keep ADMIN_FIELD_REVIEW_ENABLED=false. Only the isolated
# admin review process enables it; never enable controlled simulation there.
ADMIN_REVIEW_API_BASE_URL=
ADMIN_FIELD_REVIEW_ENABLED=false

# Optional private local UAT certificate bundle (key.pem + cert.pem), same owner,
# directory 700/files 600. Never commit/distribute; no browser trust is changed.
# Leave empty to generate an ephemeral self-signed UAT certificate.
LOCAL_UAT_TLS_DIR=
