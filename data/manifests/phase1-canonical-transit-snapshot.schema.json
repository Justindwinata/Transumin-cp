{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transum-in.local/schemas/phase1-canonical-transit-snapshot.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "created_at",
    "code_commit",
    "pipeline_version",
    "representative_service_date",
    "coverage_manifest",
    "sources",
    "canonical_counts",
    "quality_status",
    "limitations",
    "reproducibility_key"
  ],
  "properties": {
    "snapshot_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "code_commit": { "const": "SELF" },
    "code_commit_resolution": { "type": "string", "minLength": 1 },
    "pipeline_version": { "const": "PHASE_1C_V2" },
    "representative_service_date": { "type": "string", "format": "date" },
    "coverage_manifest": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_key",
          "dataset_version_id",
          "checksum_sha256",
          "manifest",
          "ingestion_run_id",
          "coverage",
          "license_status",
          "redistribution_status"
        ],
        "properties": {
          "source_key": { "type": "string", "minLength": 1 },
          "dataset_version_id": { "type": "string", "format": "uuid" },
          "checksum_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "manifest": { "type": "string", "minLength": 1 },
          "ingestion_run_id": { "type": "string", "format": "uuid" },
          "coverage": { "type": "string", "minLength": 1 },
          "license_status": { "type": "string", "minLength": 1 },
          "redistribution_status": { "type": "string", "minLength": 1 }
        }
      }
    },
    "canonical_counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "quality_status": { "type": "string", "minLength": 1 },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "reproducibility_key": { "type": "string", "minLength": 1 }
  }
}
